# ===== Master server =====

# Secret для подписи session cookie. Сгенерируй: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# Postgres connection
DATABASE_URL=postgresql://pc:pcpwd@localhost:5432/pocket_claude

# Порт, на котором слушает master (HTTP + WS)
PORT=3100

# Публичный URL мастера (для connect.sh)
# Продакшн: https://claude.mydomain.com
# Локально: http://localhost:3100
PUBLIC_URL=http://localhost:3100

# Single-user mode (для себя): email и пароль админа создадутся при setup
SINGLE_USER_MODE=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ключ для шифрования интеграционных токенов (github etc) — AES-256-GCM
INTEGRATION_KEY=CHANGE_ME_RUN_openssl_rand_hex_32

# ===== Email (опционально) =====
# Resend API key для verification и welcome писем (https://resend.com/api-keys).
# Если не задан — emails не отправляются, ссылки логируются в stdout мастера
# (self-host друг для друга, public-launch — задай ключ).
RESEND_API_KEY=
# Адрес отправителя. До верификации домена — `onboarding@resend.dev` (только себе).
# После верификации `autmzr.com` в Resend — `Autmzr <noreply@autmzr.com>`.
RESEND_FROM=Autmzr <onboarding@resend.dev>

# ===== Web Push (PWA уведомления) =====
# VAPID-ключи для подписи push-сообщений. Сгенерируй один раз:
#   npx web-push generate-vapid-keys --json
# Если не задан VAPID_PUBLIC_KEY — PWA-уведомления отключены целиком.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# `mailto:` адрес для VAPID `sub` — push-сервисы шлют сюда нотификации
# об отозванных подписках и проблемах. Можно любой работающий email.
VAPID_SUBJECT=mailto:hello@example.com

# ===== GitHub OAuth (опционально) =====
# Для "Sign in with GitHub" + clone-as-project из приватных репозиториев.
# Регистрация OAuth-приложения: github.com/settings/developers → New OAuth App.
#   Authorization callback URL: https://your-domain/api/auth/github/callback
# Если не задан — кнопка GitHub на /login прячется, clone-from-github
# доступен только для публичных репов (без авторизации).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===== Analytics (опционально) =====
# Plausible domain (например cmd.autmzr.com). Если не задан — аналитика не подключается.
# Cookie-less, GDPR-friendly, никаких consent-баннеров не требует.
PLAUSIBLE_DOMAIN=
# Опционально — кастомный URL скрипта (если проксируешь через свой домен от adblock).
PLAUSIBLE_SCRIPT_URL=
